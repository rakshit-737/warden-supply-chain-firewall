# Warden X backend settings (read by app/core/config.py from the environment or backend/.env).
#
# Local development: copy to backend/.env. Unset settings use the defaults in app/core/config.py; the
# values below are those defaults. Docker Compose: use the repository-root .env.example instead -
# docker-compose.yml sets the datastore URLs, proxy trust and secrets for the containers.
#
# ENV=production enforces hardening at startup (strong SECRET_KEY, non-default admin password, DEBUG
# off, gVisor for the optional sandbox) and refuses to start otherwise. Never put real secrets here.

# --- Environment ------------------------------------------------------------------------------
# development | staging | production | test
ENV=development
DEBUG=false

# --- Security -----------------------------------------------------------------------------------
# Required in production (>= 32 characters). If unset in development, a random key is generated at
# each start, so sessions do not survive restarts.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Key for keyed fingerprints of secrets found in analysed packages (defaults to SECRET_KEY).
# SECRET_FINGERPRINT_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list or JSON array.
CORS_ORIGINS=http://localhost:5173

# --- First-run bootstrap admin -----------------------------------------------------------------
FIRST_ADMIN_EMAIL=admin@warden.io
# Unset = the built-in development default, which production refuses. Do not set it to an empty
# value: an empty value is taken literally.
# FIRST_ADMIN_PASSWORD=

# --- Datastores ---------------------------------------------------------------------------------
DATABASE_URL=sqlite+pysqlite:///./warden.db
# PostgreSQL form: postgresql+psycopg://warden:<password>@<host>:5432/warden
REDIS_URL=redis://localhost:6379/0
# true = fall back to an in-process cache and rate limiter when Redis is unreachable (development
# only: in-process limits are per process).
REDIS_OPTIONAL=true

# --- API hardening ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=4194304
# Reverse proxies (IPs or CIDRs) whose X-Forwarded-For is trusted for client IPs. Empty = none.
TRUSTED_PROXY_IPS=

# --- Analysis pipeline --------------------------------------------------------------------------
SCAN_TIMEOUT_SECONDS=180
ANALYZER_TIMEOUT_SECONDS=60
ANALYZER_WORKERS=4
FETCH_TIMEOUT_SECONDS=20
MAX_DOWNLOAD_BYTES=26214400
MAX_EXTRACTED_BYTES=125829120
MAX_EXTRACTED_FILES=25000
ANALYZE_WHEELS=true
FAIL_ON_VERSION_NOT_FOUND=true
VERDICT_CACHE_TTL_SECONDS=3600
# max (conservative) | mean
SCORE_FUSION=max
# Comma-separated analyzer names. Empty ENABLED_ANALYZERS = every registered analyzer.
ENABLED_ANALYZERS=
DISABLED_ANALYZERS=

# --- Optional external tools (availability is detected and reported; results are never faked) ----
TOOL_TIMEOUT_SECONDS=120
YARA_ENABLED=true
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
CONTAINER_SCAN_TIMEOUT_SECONDS=900

# --- Vulnerability intelligence -----------------------------------------------------------------
INTEL_ENABLED=true
# true = make no outbound intelligence requests (OSV, CISA KEV, FIRST EPSS, NVD).
INTEL_OFFLINE=false
INTEL_TIMEOUT_SECONDS=15
INTEL_CACHE_TTL_SECONDS=21600
# NVD is opt-in because of its strict public rate limits. Supply NVD_API_KEY via the environment or a
# secret store, not a committed file.
NVD_ENABLED=false
# NVD_API_KEY=

# --- Provenance / dependency confusion ----------------------------------------------------------
PROVENANCE_ENABLED=true
DORMANCY_THRESHOLD_DAYS=365
# Comma-separated name patterns of internal packages, e.g. acme-*,acme_internal*
PRIVATE_PACKAGE_PATTERNS=
PRIVATE_INDEX_URLS=
# Local snapshot of public project names, so private names are not disclosed to the public index.
# PUBLIC_INDEX_SNAPSHOT_PATH=
DEPCONF_ALLOW_PUBLIC_LOOKUP=false

# --- SBOM / dependency graph --------------------------------------------------------------------
MAX_MANIFEST_BYTES=2097152
MAX_PROJECT_COMPONENTS=2000
MAX_GRAPH_NODES=5000
SBOM_RESOLVE_TRANSITIVE=false

# --- Continuous monitoring / events -------------------------------------------------------------
MONITOR_ENABLED=false
MONITOR_POLL_INTERVAL_SECONDS=3600
MONITOR_BATCH_SIZE=25

# --- Observability ------------------------------------------------------------------------------
METRICS_ENABLED=true
# When set, /metrics requires "Authorization: Bearer <token>". Leave unset only where /metrics is
# unreachable from untrusted networks.
#   python -c "import secrets; print(secrets.token_hex(32))"
# METRICS_TOKEN=
OTEL_ENABLED=false

# --- Machine learning ---------------------------------------------------------------------------
# Optional sha256 of app/analysis/artifacts/model.joblib; on mismatch the model is disabled and
# scoring falls back to rules only.
# MODEL_ARTIFACT_SHA256=

# --- Optional dynamic sandbox (off by default; production requires gVisor / runsc) --------------
SANDBOX_ENABLED=false
SANDBOX_RUNTIME=runsc
