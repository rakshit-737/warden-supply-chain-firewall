# Copy to .env and adjust. In production, ENV=production enforces hardening (strong
# SECRET_KEY, non-default admin password, DEBUG off) or the app refuses to start.

ENV=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

# First-run bootstrap admin (change the password before first run in production).
FIRST_ADMIN_EMAIL=admin@warden.io
FIRST_ADMIN_PASSWORD=ChangeMe_Warden!2026

# Datastores (docker-compose provides these hostnames).
DATABASE_URL=postgresql+psycopg://warden:warden@db:5432/warden
REDIS_URL=redis://cache:6379/0
REDIS_OPTIONAL=false

# CORS (comma-separated). The frontend origin in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Rate limits (requests per minute).
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# Analysis tuning.
SCORE_FUSION=max
VERDICT_CACHE_TTL_SECONDS=3600
