      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (ecosystem) (rate(scans_total[$__rate_interval])) * 60",
          "legendFormat": "{{ecosystem}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Decisions by type",
