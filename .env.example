# Warden - Docker Compose environment
#
# Copy to `.env` in the repository root (git-ignored) and fill in every REQUIRED value. The compose
# file uses ${VAR:?}, so Compose refuses to start while any of them is unset or empty; there are
# deliberately no insecure fallbacks. Never commit the filled-in file.
#
# Generate every secret separately (Python 3.6+, standard library only):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # FIRST_ADMIN_PASSWORD, GRAFANA_ADMIN_PASSWORD
#   python -c "import secrets; print(secrets.token_hex(32))"       # POSTGRES_PASSWORD, REDIS_PASSWORD, METRICS_TOKEN
#
# Use hex for POSTGRES_PASSWORD and REDIS_PASSWORD: they are embedded in DATABASE_URL / REDIS_URL and in
# the Redis configuration, where other characters would need escaping.

# ================================ REQUIRED =================================

# JWT signing key. Production refuses values shorter than 32 characters and known placeholders.
SECRET_KEY=

# Bootstrap admin password, used only to create the first admin when the database has no users.
# Production refuses the built-in default. Rotate it after the first sign-in.
FIRST_ADMIN_PASSWORD=

# PostgreSQL password for the `warden` role (hex). Applied only when the pgdata volume is first
# initialised; see deploy/README.md to rotate it on an existing volume.
POSTGRES_PASSWORD=

# Redis `requirepass` (hex).
REDIS_PASSWORD=

# Bearer token the API requires on /metrics. Prometheus (observability profile) reads the same value
# from the file deploy/secrets/metrics_token, which you create from this value (deploy/README.md shows
# the command). After changing it, rewrite that file and recreate both api and prometheus.
METRICS_TOKEN=

# Grafana admin password (observability profile). Set it even if you never enable that profile: the
# compose file is validated as a whole, and a missing required variable aborts every command.
GRAFANA_ADMIN_PASSWORD=

# ================================ OPTIONAL =================================
# The values shown are the defaults used by docker-compose.yml; uncomment a line to change it.

# Bootstrap admin e-mail address.
# FIRST_ADMIN_EMAIL=admin@warden.io

# Host address and port the dashboard is published on. Keep 127.0.0.1 unless a TLS-terminating
# proxy on another interface forwards to it.
# WARDEN_HTTP_BIND=127.0.0.1
# WARDEN_HTTP_PORT=8080

# Public origin of the dashboard (the API's CORS allow-list).
# WARDEN_PUBLIC_ORIGIN=http://localhost:8080

# Subnet of the `edge` network and the web container's fixed address inside it. The API trusts
# X-Forwarded-For only from WARDEN_WEB_IPV4, which must lie inside WARDEN_EDGE_SUBNET. Change both if the
# subnet collides with an existing network.
# WARDEN_EDGE_SUBNET=172.30.10.0/24
# WARDEN_WEB_IPV4=172.30.10.10

# Uvicorn worker processes per API container. Values above 1 make Prometheus counters inconsistent
# (per-process registries); run more containers instead.
# UVICORN_WORKERS=1

# Grafana (observability profile).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_BIND=127.0.0.1
# GRAFANA_PORT=3000
# GRAFANA_ROOT_URL=http://localhost:3000/
# GRAFANA_COOKIE_SECURE=false
